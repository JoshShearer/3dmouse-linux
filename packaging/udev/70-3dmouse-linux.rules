# 3DMouse Linux – device access rules.
# GENERATED by tools/gen-udev-rules.py from crates/sm-registry/data/devices.toml.
# Do not edit by hand; a test (sm-registry) fails if this file is stale.
#
# * hidraw: TAG+="uaccess" gives the user of the active local seat read/write
#   access (logind ACL). Needed by applications that talk to the device via
#   hidapi themselves (e.g. PrusaSlicer). 3dmoused runs as root and does
#   not depend on it. Remote/inactive users get nothing.
# * input: LIBINPUT_IGNORE_DEVICE keeps the compositor from treating the
#   device as a pointer or joystick so it cannot move the cursor twice.

ACTION=="remove", GOTO="3dmouse_linux_end"
SUBSYSTEM!="hidraw|input", GOTO="3dmouse_linux_end"

# SpaceMouse Compact (256f:c635, usb)
SUBSYSTEM=="hidraw", KERNELS=="0003:256F:C635.*", TAG+="uaccess", ENV{THREEDMOUSE_LINUX}="1"
SUBSYSTEM=="input", KERNELS=="0003:256F:C635.*", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{THREEDMOUSE_LINUX}="1"
