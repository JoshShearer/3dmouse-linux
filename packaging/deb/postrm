#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    systemctl disable 3dmoused.service >/dev/null 2>&1 || true
    systemctl --global disable 3dmouse-agent.service 3dmouse-osd.service >/dev/null 2>&1 || true
    udevadm control --reload 2>/dev/null || true
    [ -d /run/systemd/system ] && systemctl daemon-reload || true
fi
exit 0
