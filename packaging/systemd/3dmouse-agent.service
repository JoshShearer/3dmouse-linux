[Unit]
Description=3DMouse Linux session agent (profiles, buttons, focus)
Documentation=file:///usr/share/doc/3dmouse-linux/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/3dmouse-agent
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=graphical-session.target
